# Local-only credentials match compose.yaml. Never reuse them outside development.
DATABASE_URL=postgresql://parkingbusiness:local-development-only@127.0.0.1:5432/parkingbusiness
# Separate disposable server/database/user; integration tests reset this database.
TEST_DATABASE_URL=postgresql://parkingbusiness_test:local-test-only@127.0.0.1:5433/parkingbusiness_test
PORT=3000
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=250
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=1000
DB_LOCK_TIMEOUT_MS=250
DB_IDLE_TRANSACTION_TIMEOUT_MS=1000
# Empty disables gate access. Set locally using unique random secrets (32+ characters).
# Shape: [{"id":"entrance-1","buildingId":"PB-AMS-9X4T","role":"ENTRANCE","secret":"<random secret>"}]
GATE_CREDENTIALS=[]
