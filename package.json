{
  "name": "parkingbusiness-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint src test scripts simulator drizzle.config.ts eslint.config.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/config.test.js .test-dist/test/test-database.test.js .test-dist/test/audit.test.js .test-dist/test/occupancy.test.js .test-dist/test/check-in.test.js .test-dist/test/billing.test.js .test-dist/test/check-out.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test --test-concurrency=1 .test-dist/test/database.integration.test.js .test-dist/test/persistence.integration.test.js .test-dist/test/occupancy.integration.test.js .test-dist/test/runtime.integration.test.js .test-dist/test/check-in.integration.test.js .test-dist/test/check-out.integration.test.js",
    "db:up": "docker compose up -d --wait postgres postgres-test",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/database/seed.ts",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:fresh": "docker compose rm --stop --force postgres-test && docker compose up -d --wait postgres-test",
    "audit:dependencies": "node --import tsx scripts/audit.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "type": "module"
}
